RewriteEngine On
Options -Indexes

# Keep repository metadata and editor files private while allowing ACME challenges.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END,NC]

# Keep application internals and local configuration files out of public URLs.
RewriteRule ^(?:app|config|configs|includes|routes|tests)(?:/|$) - [F,END,NC]
RewriteRule ^(?:database\.sql|\.env(?:\..*)?|composer\.(?:json|lock))$ - [F,END,NC]

# Jika file atau folder memang ada, biarkan Apache melayaninya.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Jika nama tanpa ekstensi memiliki pasangan file PHP, gunakan file tersebut.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [END]

# Route unmatched requests through the public front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,END]
